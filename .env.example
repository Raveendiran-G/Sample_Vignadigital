# Copy to .env (docker compose reads it) or set in your host's dashboard.
NODE_ENV=production
PORT=3000
# Public https URL customers will reach. Baked into every QR code!
BASE_URL=https://menu.vignadigital.com
# Generate: openssl rand -hex 32
SESSION_SECRET=
# MongoDB Atlas connection (required). Atlas > Connect > Drivers shows the string; the user needs read/write access.
# Atlas > Security > Network Access must allow this server's IP address.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Database name inside the cluster (default digitalmenu). Keep it separate from other projects' data.
MONGODB_DB=digitalmenu
# Super admin, created on first start only
ADMIN_EMAIL=admin@vignadigital.com
ADMIN_PASSWORD=
# Where uploaded photos are stored (mount a persistent volume here)
DATA_DIR=/data
# Number of reverse-proxy hops in front of the app (default 1)
# TRUST_PROXY=1
# Shown as a "Get your menu" / "Contact us" button on the landing page (optional)
CONTACT_EMAIL=hello@vignadigital.com
# Max login attempts per IP per 15 minutes (default 20)
# LOGIN_RATE_LIMIT=20
